{
  "name": "sangsoe",
  "version": "0.1.0-rc.2",
  "description": "Orchestration for Claude Code sessions on Orca",
  "private": true,
  "type": "module",
  "bin": {
    "sangsoe": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    ".claude-plugin/",
    "claude-plugin/",
    "!claude-plugin/agents/README.md",
    "orca-plugin/",
    "build-info.json",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "node --test \"{core,cli,orca-plugin,claude-plugin,test}/**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
